NODE_ENV=development
PORT=3001
# Testing only: use `*` to allow every browser origin. Use an explicit
# comma-separated allowlist in production.
CORS_ORIGINS=*
TRUST_PROXY=false
AUTH_PROVIDER=development
MEDIA_PROVIDER=local-files
DATA_DIRECTORY=.data
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_BYTES=10485760
DEMO_STORE_ID=store-sweet-bakes
# Optional: PEM CA downloaded for this Supabase project from its Database SSL settings.
# Relative paths are resolved from the backend process working directory.
# SUPABASE_DATABASE_CA_FILE=./certs/supabase-root.crt
# At least 32 random characters; signs store-scoped newsletter unsubscribe links.
CUSTOMER_LINK_SECRET=

# Firebase Cloud Functions
# Set these in Firebase Functions environment/secrets for deployed functions.
FUNCTIONS_REGION=us-central1

# Required only when the matching cloud provider is selected.
# Firebase Admin auth project ID. The JELLY_ prefix avoids Firebase-reserved
# environment variable names in Cloud Functions.
JELLY_FIREBASE_PROJECT_ID=
GCS_BUCKET=
GCS_PROJECT_ID=

# Server only. Required in production; leave all empty to disable Stripe locally.
# Supply credentials through your deployment secret manager; never use NEXT_PUBLIC_ prefixes.
STRIPE_SECRET_KEY=
STRIPE_ACCOUNTS_V2_VERSION=
# Set version to 2026-08-26.dahlia with the pinned Stripe 22.6.2 SDK.
# This configuration must enable cards only; the ID alone cannot prove its Dashboard settings.
STRIPE_CARD_PAYMENT_METHOD_CONFIGURATION_ID=
# Separate event destinations require separate signing secrets.
STRIPE_ACCOUNTS_V2_WEBHOOK_SECRET=
STRIPE_CONNECT_PAYMENTS_WEBHOOK_SECRET=
SCHEDULER_SECRET=

# Order notifications and private downloads. Apply both 20261022 migrations first.
# Enable the workspace per store from the Orders screen after verification.
STOREFRONT_PUBLIC_URL=http://127.0.0.1:3200
# Firebase emulator example:
ORDER_PUBLIC_API_URL=http://127.0.0.1:5001/jelly-507118/us-central1/api
# Persistent random secret of at least 32 characters; backend only.
DIGITAL_TOKEN_SECRET=
SUPABASE_DIGITAL_BUCKET=
# Development only: private files are never mounted as static/public media.
DIGITAL_STORAGE_DIRECTORY=.data/private-digital
# Empty SMTP host uses a local capture transport in development; never production.
ORDER_SMTP_HOST=
ORDER_SMTP_PORT=587
ORDER_SMTP_SECURE=false
ORDER_SMTP_USER=
ORDER_SMTP_PASSWORD=
ORDER_EMAIL_FROM=
ORDER_EMAIL_DOMAIN_VERIFIED=false
