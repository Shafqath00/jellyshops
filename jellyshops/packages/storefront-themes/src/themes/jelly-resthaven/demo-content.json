  "pages": [
    {
      "handle": "about",
      "title": "About Resthaven",
      "body": [
        "We make beds and bedroom furniture for calm, comfortable rooms: honest materials, careful making and measurements you can trust.",
        "Every bed is built to order in our partner workshops in the UK and delivered free by our own two-person team."
      ]
    },
    {
      "handle": "delivery",
      "title": "Delivery",
      "body": [
        "Delivery is free to most UK addresses. Beds and furniture arrive in 5-7 working days; mattresses and bedding in 2-3.",
        "Our two-person team brings large pieces to the room of your choice and takes the packaging away."
      ]
    },
    {
      "handle": "returns",
      "title": "Returns",
      "body": [
        "Return anything within 30 days for a full refund. Mattresses come with a 100-night trial: if it isn't right, we collect it for free.",
        "Made-to-order fabrics and sizes can be returned if they arrive damaged or faulty."
      ]
    },
    {
      "handle": "mattress-guide",
      "title": "Choosing a mattress",
      "body": [
        "Side sleepers usually prefer soft to medium, back sleepers medium to medium firm, and front sleepers firm.",
        "Hybrid mattresses combine springs and foam; pocket sprung mattresses feel cooler and bouncier; memory foam hugs your shape."
      ]
    }
  ]
