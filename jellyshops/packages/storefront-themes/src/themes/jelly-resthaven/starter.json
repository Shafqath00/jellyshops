                "id": "resthaven-faq-3",
                "type": "faq-item",
                "enabled": true,
                "settings": {
                  "question": "Is the mattress included with a bed?",
                  "answer": "Each product page says what is included. Beds and mattresses are usually sold separately, so you can pair the comfort you prefer."
