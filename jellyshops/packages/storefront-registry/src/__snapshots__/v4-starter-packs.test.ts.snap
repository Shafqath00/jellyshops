    "templates": [
      {
        "handle": "default",
        "key": "jelly-signature-template-home",
        "layout": {
          "sections": [
            {
              "globalSectionId": "jelly-signature-global-announcement-section",
              "kind": "global",
            },
            {
              "globalSectionId": "jelly-signature-global-header-section",
              "kind": "global",
            },
            {
              "kind": "inline",
              "section": {
                "blocks": [
                  {
                    "enabled": true,
                    "id": "jelly-signature-home-hero-heading",
                    "settings": {
                      "text": "Everyday pieces, thoughtfully made.",
                    },
                    "type": "heading",
                  },
                  {
                    "enabled": true,
                    "id": "jelly-signature-home-hero-copy",
                    "settings": {
                      "text": "Considered essentials for the home and wardrobe, chosen to be used and loved for years.",
                    },
                    "type": "text",
                  },
                  {
                    "enabled": true,
                    "id": "jelly-signature-home-hero-button",
                    "settings": {
                      "href": "/shop",
                      "label": "Shop the collection",
                    },
                    "type": "button",
                  },
                  {
                    "enabled": true,
                    "id": "jelly-signature-home-hero-secondary",
                    "settings": {
                      "href": "/about",
                      "label": "Our story",
                    },
                    "type": "button",
                  },
                ],
                "enabled": true,
                "id": "jelly-signature-home-hero",
                "settings": {
                  "colorScheme": "soft",
                  "contentAlignment": "left",
                  "eyebrow": "New season",
                  "height": "large",
                  "image": {
                    "alt": "A bright living room with neutral textiles and woven wall decor",
                    "url": "https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=1600&q=80",
                  },
                  "layout": "split",
