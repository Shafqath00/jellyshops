{
  "name": "jelly-shop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:storefront-packages": "npm run build --workspace @jelly/storefront-schema && npm run build --workspace @jelly/storefront-registry && npm run build --workspace @jelly/storefront-themes",
    "dev": "npm run build:storefront-packages && next dev --turbopack",
    "prebuild": "npm run build:storefront-packages",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:storefront-packages",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:e2e:onboarding": "node scripts/run-onboarding-e2e.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.9.1",
    "@jelly/storefront-registry": "0.1.0",
    "@jelly/storefront-renderer": "0.1.0",
    "@jelly/storefront-schema": "0.1.0",
    "@jelly/storefront-themes": "0.1.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "@stripe/react-stripe-js": "6.10.0",
    "@stripe/stripe-js": "9.16.0",
    "@supabase/supabase-js": "2.116.0",
    "@tiptap/extension-blockquote": "3.31.3",
    "@tiptap/extension-bold": "3.31.3",
    "@tiptap/extension-bullet-list": "3.31.3",
    "@tiptap/extension-document": "3.31.3",
    "@tiptap/extension-hard-break": "3.31.3",
    "@tiptap/extension-heading": "3.31.3",
    "@tiptap/extension-italic": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list-item": "3.31.3",
    "@tiptap/extension-ordered-list": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-text": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "clsx": "2.1.1",
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "29.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
