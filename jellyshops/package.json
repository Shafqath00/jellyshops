{
  "name": "jelly-shop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build --workspace @jelly/storefront-schema && next dev --turbopack",
    "prebuild": "npm run build --workspace @jelly/storefront-schema",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build --workspace @jelly/storefront-schema",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-playwright.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "latest",
    "@jelly/storefront-registry": "0.1.0",
    "@jelly/storefront-renderer": "0.1.0",
    "@jelly/storefront-schema": "0.1.0",
    "@jelly/storefront-themes": "0.1.0",
    "@stripe/react-stripe-js": "^6.10.0",
    "@stripe/stripe-js": "^9.16.0",
    "clsx": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "jsdom": "^29.0.0",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
