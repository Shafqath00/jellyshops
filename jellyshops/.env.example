NEXT_PUBLIC_STORE_EDITOR_API_URL=http://localhost:3001
# Enable after configuring Google in Supabase and verifying the merchant callback in staging.
NEXT_PUBLIC_JELLYSHOP_GOOGLE_SIGN_IN=false
# Publishable key only (pk_test_... in test mode). Secret keys belong in backend/.env, never here.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_the_publishable_key_for_the_same_stripe_platform

# Store page caching (see src/features/storefront/storefront-cache.ts).
# Public address of the site, used for canonical links and share images (pages no longer read the request host).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret the backend sends to POST /api/revalidate when a store changes. Same value as the backend's.
STOREFRONT_REVALIDATE_SECRET=
# Safety limit in seconds for when no refresh arrives. 300 by default; 3600 once the backend refresh is configured.
STOREFRONT_CACHE_SECONDS=300

# Shop addresses (docs/launch/subdomains-go-live-checklist.md). path = jellyshop.io/<shop> (default),
# subdomain = <shop>.jellyshop.io with the admin on admin. and staff on platform., preview = /_shop/<shop> on previews.
NEXT_PUBLIC_STORE_LINKS=path
# The main domain; may carry a port in development (localhost:3230 with *.localhost shops).
NEXT_PUBLIC_ROOT_DOMAIN=jellyshop.io
