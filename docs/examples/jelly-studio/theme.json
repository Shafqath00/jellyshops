{
  "id": "jelly-studio",
  "name": "Jelly Studio",
  "version": "1.0.0",
  "description": "A calm, image-led theme for small studios and makers.",
  "assetPrefix": "/themes/jelly-studio/",
  "previewAsset": "/themes/jelly-studio/preview.svg",
  "assets": {
    "stylesheets": [],
    "scripts": [],
    "fonts": [],
    "icons": [{ "id": "mark", "path": "/themes/jelly-studio/mark.svg" }],
    "assets": [],
    "preview": { "path": "/themes/jelly-studio/preview.svg", "alt": "Jelly Studio theme preview" }
  },
  "layout": "standard",
  "enabled": true,
  "settingsDefaults": {
    "colors": { "primary": "#22313f", "background": "#fbfaf8", "text": "#22313f", "surface": "#ffffff", "accent": "#d9a441", "secondary": "#5b6570" },
    "typography": { "headingFont": "Fraunces", "bodyFont": "Inter", "headingWeight": 400 },
    "buttons": { "style": "solid", "radius": "soft" },
    "layout": { "contentWidth": 1200, "sectionGap": 80 },
    "productCard": { "imageRatio": "portrait", "alignment": "left" },
    "branding": { "logoUrl": "" }
  },
  "sections": [
    {
      "type": "jelly-studio/promo-banner",
      "name": "Promo banner",
      "supportedPages": [
        "home",
        "page"
      ],
      "settings": [
        {
          "id": "heading",
          "type": "text",
          "label": "Heading",
          "default": "Free delivery this month"
        },
        {
          "id": "body",
          "type": "textarea",
          "label": "Text",
          "default": "Order before Friday and we cover the postage."
        },
        {
          "id": "showButton",
          "type": "checkbox",
          "label": "Show the button",
          "default": true
        },
        {
          "id": "buttonLabel",
          "type": "text",
          "label": "Button text",
          "default": "Shop now"
        },
        {
          "id": "buttonLink",
          "type": "link",
          "label": "Button link",
          "default": "/search"
        },
        {
          "id": "photo",
          "type": "image",
          "label": "Photo"
        }
      ],
      "layout": {
        "direction": "horizontal",
        "align": "left",
        "gap": 32,
        "width": "wide"
      },
      "elements": [
        {
          "kind": "image",
          "image": "{photo}",
          "ratio": "landscape"
        },
        {
          "kind": "group",
          "direction": "vertical",
          "gap": 12,
          "elements": [
            {
              "kind": "heading",
              "text": "{heading}"
            },
            {
              "kind": "text",
              "text": "{body}"
            },
            {
              "kind": "button",
              "label": "{buttonLabel}",
              "href": "{buttonLink}",
              "when": "showButton"
            }
          ]
        }
      ]
    }
  ]
}
